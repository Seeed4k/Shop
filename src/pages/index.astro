---
import { Image } from 'astro:assets';
import Grundlayout from '../layouts/Grundlayout.astro';
import Produktraster from '../components/Produktraster.astro';
import { einstellungen } from '../lib/einstellungen';
import { bildFinden } from '../lib/bilder';
import { kategorienLaden, hervorgehobeneProdukte, kategorieLink } from '../lib/inhalte';
import { vorschaubildErzeugen } from '../lib/vorschaubild';
import { texte } from '../lib/texte';

/**
 * Startseite: Überschrift, Text, Bild, hervorgehobene Produkte, Kategorie-Kacheln.
 */
const { shop } = einstellungen;
const kategorien = await kategorienLaden();
const empfehlungen = await hervorgehobeneProdukte();
const startbild = bildFinden(shop.startseiteBild, 'Startseitenbild in den Einstellungen');
const vorschaubild = await vorschaubildErzeugen(startbild, Astro.site);
---

<Grundlayout
  titel={shop.name}
  beschreibung={shop.startseiteText.slice(0, 160) || `Das Angebot von ${shop.name}`}
  vorschaubild={vorschaubild}
  vorschaubildAlt={shop.startseiteBildAlt}
  titelAlleinstehend
>
  <section class:list={['huelle', 'aufmacher', startbild && 'aufmacher--mit-bild']}>
    <div class="aufmacher__text">
      <h1>{shop.startseiteUeberschrift || shop.name}</h1>
      {shop.startseiteText && <p class="aufmacher__absatz">{shop.startseiteText}</p>}
    </div>

    {startbild && (
      <Image
        src={startbild}
        alt={shop.startseiteBildAlt ?? ''}
        widths={[640, 960, 1400]}
        sizes="(min-width: 60rem) 34rem, 92vw"
        loading="eager"
        fetchpriority="high"
        class="aufmacher__bild"
      />
    )}
  </section>

  {empfehlungen.length > 0 && (
    <section class="huelle abschnitt">
      <h2>{texte.startseite.hervorgehoben}</h2>
      <Produktraster produkte={empfehlungen} />
    </section>
  )}

  {kategorien.length > 0 && (
    <section class="huelle abschnitt">
      <h2>{texte.startseite.kategorienUeberschrift}</h2>
      <ul class="kacheln">
        {kategorien.map((kategorie, index) => (
          <li class="kachel">
            {kategorie.bild && (
              <Image
                src={kategorie.bild}
                alt={kategorie.bildAlt}
                widths={[400, 600, 900]}
                sizes="(min-width: 60rem) 21rem, (min-width: 40rem) 45vw, 92vw"
                loading={index < 3 ? 'eager' : 'lazy'}
                class="kachel__bild"
              />
            )}
            <div class="kachel__text">
              <h3 class="kachel__name">
                <a href={kategorieLink(kategorie)}>{kategorie.name}</a>
              </h3>
              {kategorie.beschreibung && <p class="kachel__beschreibung">{kategorie.beschreibung}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {kategorien.length === 0 && (
    <section class="huelle abschnitt">
      <p>{texte.startseite.keineProdukte}</p>
    </section>
  )}
</Grundlayout>

<style>
  .aufmacher {
    padding-block: 2.5rem 1rem;
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .aufmacher--mit-bild {
      grid-template-columns: 1fr 34rem;
      gap: 3rem;
      padding-block: 3.5rem 1.5rem;
    }
  }

  .aufmacher__absatz {
    max-width: 38rem;
    font-size: 1.1rem;
    color: var(--farbe-text-leise);
    margin-bottom: 0;
  }

  .aufmacher__bild {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .abschnitt {
    padding-block: 1.75rem;
  }

  .kacheln {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .kachel {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--farbe-flaeche);
    border: 1px solid var(--farbe-linie);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .kachel:hover {
    border-color: var(--farbe-primaer);
    box-shadow: var(--schatten);
  }

  .kachel:has(a:focus-visible) {
    outline: 3px solid var(--farbe-akzent);
    outline-offset: 2px;
  }

  .kachel__bild {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .kachel__text {
    padding: 0.9rem 1rem 1.1rem;
  }

  .kachel__name {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
  }

  .kachel__name a {
    color: inherit;
    text-decoration: none;
  }

  .kachel__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .kachel__name a:hover {
    text-decoration: underline;
  }

  .kachel__beschreibung {
    margin: 0;
    font-size: 0.92rem;
    color: var(--farbe-text-leise);
  }
</style>
